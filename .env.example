# Atelier — chiavi API (tutte opzionali: senza chiavi l'app funziona in modalità offline)

# Google Gemini — https://aistudio.google.com/apikey  (~1.500 req/giorno gratis per Flash)
# Chiave predefinita: il router la usa per prima.
GEMINI_API_KEY=
# Chiave di riserva: idealmente creata in un ALTRO progetto Google Cloud, così la
# quota gratuita è separata. Prende il lavoro se la principale è esaurita.
GEMINI_API_KEY_FALLBACK=
# Modello Gemini (opzionale). Default: gemini-3.5-flash. Se Google cambia i limiti
# o ritira un modello, basta cambiare questa variabile e riavviare l'app.
# GEMINI_MODEL=gemini-3.5-flash

# Groq — https://console.groq.com/keys  (velocissimo, ~30 req/minuto gratis)
# Default: openai/gpt-oss-120b, che regge l'output strutturato degli stadi AI.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Cerebras — https://cloud.cerebras.ai  (1.000.000 token/giorno gratis, contesto 8k)
# Default: gpt-oss-120b (il catalogo Cerebras si è spostato sui modelli gpt-oss).
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter — https://openrouter.ai/keys  (router /free come fallback universale)
OPENROUTER_API_KEY=

# Cloudflare Workers AI — account id + token con permesso Workers AI (10.000 neurons/giorno)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Dominio pubblico ----
# Se impostata, questa variabile ha la precedenza anche su Vercel: utile quando
# il progetto ha più domini e il canonico non è quello generato dalla
# piattaforma. Senza di essa, su Vercel si usa VERCEL_PROJECT_PRODUCTION_URL.
# Va scritta **prima della build**: essendo `NEXT_PUBLIC_*`, Next la incide nel
# pacchetto in fase di costruzione e non la rilegge all'avvio.
# Usata da sitemap, robots.txt, Open Graph, dati strutturati e indirizzo canonico.
NEXT_PUBLIC_SITE_URL=

# ---- Accesso ----
# Firma delle sessioni (cookie HttpOnly, 30 giorni). Almeno 16 caratteri.
# OBBLIGATORIA in produzione: senza di essa il login GitHub/Google risponde
# «Sessione non configurata» invece di firmare con una chiave prevedibile.
# Generane una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ATELIER_SESSION_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Callback da registrare: http://localhost:3000/api/auth/github/callback
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback da registrare: http://localhost:3000/api/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Archivio cloud (opzionale) ----
# Progetto Supabase con lo schema `atelier` (vedi docs/migrations/002-cloud-entry.sql).
# Senza tutte e tre le variabili il pannello «Archivio cloud» resta spento e i
# progetti vivono solo nel browser: nessun errore, nessun degrado.
SUPABASE_URL=
# Chiave publishable (`sb_publishable_…`). È pubblica per costruzione: serve
# solo a indirizzare le RPC, non dà accesso ai dati.
SUPABASE_PUBLISHABLE_KEY=
# Segreto di firma della busta HMAC. Generane uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# e scrivi lo stesso valore in `atelier.secrets` (nome `atelier_cloud_secret`).
ATELIER_CLOUD_SECRET=

# Alias equivalenti, per chi preferisce i nomi `NEXT_PUBLIC_*` (usati dal client
# Supabase). Se entrambe sono presenti vince la variante senza prefisso.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
